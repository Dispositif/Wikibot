[mysqld]
# Tuned for a RAM-constrained VPS.
# Defaults assume a dedicated server with several GB of RAM available just for
# MySQL, which is not the case here.

# Default is often 128M-ish per GB of RAM available; here we cap it hard since
# this is a small single-app database, not a high-traffic one.
innodb_buffer_pool_size = 128M
innodb_log_file_size = 32M

key_buffer_size = 8M
table_open_cache = 128
max_connections = 20

# Performance Schema alone can use 50-100+ MB by default; not needed for a
# small bot database with no perf monitoring requirement.
performance_schema = OFF
