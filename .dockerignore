# Never in the image: large local dumps, .git, secrets, dev artifacts.
# (COPY . . does not respect .gitignore, only .dockerignore — hence this
# separate file, otherwise large local files end up in the image unintentionally.)

.git
.dockerignore
docker-compose.yml

vendor/
node_modules/

# Secrets: provided to the container via env_file/environment at runtime, never
# copied into an image (Docker layers are easy to inspect/leak).
.env
.env.*
!.env.dist

# Large/local data (see .gitignore for the detailed reasoning)
resources/*.sql
resources/cirrusSearch-*.txt
resources/corpus_lienWeb_url.txt
resources/titles/
resources/wikiwix-log-11-01.txt
docs/

# Stateful runtime files (dedup lists, API quota counters): must be bind-mounted
# as volumes so state persists across container runs, never baked into the
# image as a stale snapshot of whatever exists locally at build time.
src/Application/resources/article_externRef_edited.txt
src/Infrastructure/resources/google_quota.json
src/Application/CLI/*.html
src/Application/CLI/dump.rdb
src/Application/CLI/voteadq.txt

# Private code (see .gitignore): not needed in the prod image
src/Application/Bazar/
src/Domain/Bazar/
src/Domain/TALN/
src/Application/Web/
src/Infrastructure/unused/

# tests/ IS included now (one image runs both workers and tests, see
# docker/php/Dockerfile) — only its generated artifacts stay out.
.run/
.idea/
*.log
tests/coverage.txt
tests/clover.xml
.phpunit.cache/

# Tooling that has no business being in the image
bin/backup-private.sh
